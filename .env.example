# OpportunityOS Environment Configuration

# Supabase Integration (Optional: App runs fully in Demo Mode without Supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# AI Provider Configuration (Optional: Deterministic fallbacks provided for all workflows)
# Supports any OpenAI-compatible API (OpenAI, DeepSeek, Groq, Ollama, OpenRouter)
VITE_AI_ENDPOINT=https://api.openai.com/v1
VITE_AI_API_KEY=your-api-key-here
VITE_AI_MODEL=gpt-4o-mini
